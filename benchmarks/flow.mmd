sequenceDiagram
    participant Consumer as Consumer
    participant Store as Local Store
    participant NFD as NFD
    participant Producer as Producer

    Consumer->>Store: "/height/Mt.Fuji/"

    alt ローカルにある場合
        Store-->>Consumer: Hit → "3776m"
    else リモートにある場合
        Store-->>Consumer: Miss
        Consumer->>NFD: express_interest "/height/Mt.Fuji/"
        NFD->>Producer: Interest
        Producer-->>NFD: Data b'3776m'
        NFD-->>Consumer: "3776m"
    end

    Consumer->>Consumer: print "3776m"
