// Simple grammar: only print statements of string literals

start: statement+

// 定義できる文法
?statement: LET IDENTIFIER "=" expr    -> assignment_stmt
         | PRINT expr                   -> print_stmt
         | expr                         -> expr_stmt

// 優先順位: 低い順に定義（Lark LALR では上が低優先度）
?expr: expr "+" term    -> add_expr
     | expr "-" term    -> sub_expr
     | term

?term: term "*" factor  -> mul_expr
     | term "/" factor  -> div_expr
     | factor

?factor: "-" factor                                          -> neg_expr
       | atom

?atom: STRING                                                -> string_literal
     | NUMBER                                                -> number_literal
     | IDENTIFIER "(" (expr ("," expr)*)? ")"               -> call_expr
     | IDENTIFIER                                            -> variable
     | INTEREST STRING                                       -> interest_expr
     | INTEREST IDENTIFIER                                   -> interest_var_expr
     | "(" expr ")"

LET: "let"
PRINT: "print"
INTEREST: "interest"
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/

%import common.ESCAPED_STRING -> STRING
%import common.SIGNED_NUMBER  -> NUMBER
%import common.WS
%ignore WS
